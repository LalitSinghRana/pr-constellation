{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR Graph Middle Trees",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "middleTrees"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "pr-graph-middle-trees/v1"
    },
    "middleTrees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/middleTree"
      }
    }
  },
  "$defs": {
    "reviewClass": {
      "type": "string",
      "enum": [
        "important",
        "supporting",
        "mechanical"
      ]
    },
    "changeRole": {
      "type": "string",
      "enum": [
        "runtime",
        "test",
        "storybook",
        "snapshot",
        "type",
        "docs",
        "config",
        "dependency",
        "generated",
        "formatting",
        "imports"
      ]
    },
    "codeRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileIds",
        "changedLineIds"
      ],
      "properties": {
        "fileIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changedLineIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "middleTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "reviewClass",
        "changeRole",
        "comment",
        "confidence",
        "codeRefs",
        "tree"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reviewClass": {
          "$ref": "#/$defs/reviewClass"
        },
        "changeRole": {
          "$ref": "#/$defs/changeRole"
        },
        "comment": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "codeRefs": {
          "$ref": "#/$defs/codeRefs"
        },
        "tree": {
          "$ref": "#/$defs/tree"
        }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/treeNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "treeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "reviewClass",
        "changeRole",
        "depth",
        "comment",
        "confidence",
        "codeRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reviewClass": {
          "$ref": "#/$defs/reviewClass"
        },
        "changeRole": {
          "$ref": "#/$defs/changeRole"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "comment": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "codeRefs": {
          "$ref": "#/$defs/codeRefs"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relation",
        "comment"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "comment": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
