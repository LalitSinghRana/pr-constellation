{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR Review Stack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stacks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "pr-graph-review-stack/v1"
    },
    "stacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stack"
      }
    }
  },
  "$defs": {
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "comment",
        "fileIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "comment": {
          "type": "string",
          "minLength": 1
        },
        "fileIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^file-[0-9]+$"
          }
        }
      }
    }
  }
}
