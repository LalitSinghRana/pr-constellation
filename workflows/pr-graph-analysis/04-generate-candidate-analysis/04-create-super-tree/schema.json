{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR Graph Super Tree",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "superTree"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "pr-graph-super-tree/v1"
    },
    "superTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/superNodeReference"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    }
  },
  "$defs": {
    "superNodeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "depth"
      ],
      "properties": {
        "id": {
          "description": "Use an exact middleTrees[].id value.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relation",
        "comment"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "comment": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
