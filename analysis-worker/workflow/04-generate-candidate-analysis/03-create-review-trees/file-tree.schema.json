{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR Review File Tree",
  "type": "object",
  "additionalProperties": false,
  "required": ["branches"],
  "properties": {
    "branches": {
      "description": "Ordered parent-child branches defining review order across every file in one Review Stack.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/branch"
      }
    }
  },
  "$defs": {
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentId", "childId", "order", "explanation"],
      "properties": {
        "parentId": {
          "type": "string",
          "minLength": 1
        },
        "childId": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "explanation": {
          "description": "Plain Markdown describing why the child belongs under the parent in review order. Do not use What:/Why: labels or review directives; optional final Reviewer attention: section only when needed.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
