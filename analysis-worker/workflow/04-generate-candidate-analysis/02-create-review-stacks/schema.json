{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR Review Stacks",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewStacks"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "pr-review-stacks/v1"
    },
    "reviewStacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reviewStack"
      }
    }
  },
  "$defs": {
    "reviewStack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "explanation", "fileIds"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "description": "Plain Markdown describing why these files form one coherent review unit. Do not use What:/Why: labels or review directives; optional final Reviewer attention: section only when needed.",
          "type": "string",
          "minLength": 1
        },
        "fileIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^file-[0-9]+$"
          }
        }
      }
    }
  }
}
