{
  "name": "pr-review-cockpit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "prc": "./analysis-worker/bin/prc.js"
  },
  "scripts": {
    "ab": "npm exec --yes --registry=https://registry.npmjs.org/ agent-browser@latest",
    "build": "vite build client",
    "check": "biome check . && pnpm test && vite build client",
    "dev": "node server/server.mjs --dev",
    "format": "biome format --write .",
    "install:service": "pnpm build && node server/install-service.mjs",
    "install:sync": "pnpm install:service",
    "prc": "node analysis-worker/bin/prc.js",
    "start": "node server/server.mjs",
    "test": "node --test --test-concurrency=1",
    "sync": "node server/server.mjs --sync"
  },
  "dependencies": {
    "@git-diff-view/react": "^0.1.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff2html": "^3.4.52",
    "esbuild": "^0.28.1",
    "lucide-react": "^1.25.0",
    "nuqs": "^2.9.4",
    "postcss": "^8.5.22",
    "radix-ui": "^1.6.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.14.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^24.1.3",
    "vite": "^8.1.5"
  }
}
