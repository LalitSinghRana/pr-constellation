{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR Graph Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intent",
    "summary",
    "confidence",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "pr-graph-analysis/v1"
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "depth",
        "comment",
        "confidence",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "core",
            "supporting",
            "downstream",
            "validation",
            "mechanical",
            "risk"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "comment": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relation",
        "comment"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "comment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "hunk",
        "excerpt"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "hunk": {
          "type": "string"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
